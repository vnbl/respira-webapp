# =============================================================================
# DOCKER COMPOSE — Root environment file
# Copy this file to .env and fill in the values before running docker-compose.
# This single file is sufficient to bring up the full stack with docker-compose.
# =============================================================================

# =============================================================================
# COMPOSE — Orchestration
# =============================================================================

# Proxy build target stage. Choose one: local | development | production
ENVIRONMENT=local

# Host port mapped to the proxy container port 80.
PROXY_PORT=80

# Absolute path to the repository root used for certbot bind mounts.
# Leave commented to default to the current directory.
# HOST_WORKSPACE_FOLDER=/path/to/respira-webapp

# =============================================================================
# BACKEND — Core Application
# =============================================================================

# Django secret key. Use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Replace this placeholder before any shared, staging, or production deploy.
BACKEND_SECRET_KEY=change-me-use-a-long-random-string

# Enable Django debug mode. Must be false in production.
BACKEND_DEBUG=false

# Port gunicorn listens on inside the backend container.
BACKEND_PORT=8000

# Run Django migrations automatically on container start.
BACKEND_RUN_MIGRATIONS=true

# Comma-separated list of origins allowed to make cross-site requests.
# In docker-compose: frontend service (http://frontend:4321) if it makes direct backend calls.
# Local dev: http://localhost:8000 and http://127.0.0.1:8000 for standalone backend.
BACKEND_CORS_ALLOWED_ORIGINS=http://frontend:4321,http://localhost:8000,http://127.0.0.1:8000

# Additional comma-separated hostnames for Django ALLOWED_HOSTS.
# Use bare hosts only (no scheme, no port), for example: demo.proyectorespira.net,backend
# BACKEND_ALLOWED_HOSTS=demo.proyectorespira.net,backend

# =============================================================================
# GLITCHTIP — Error Monitoring (optional)
# =============================================================================

# Blank DSNs disable error reporting. Backend and frontend use separate projects.
BACKEND_GLITCHTIP_DSN=
PUBLIC_GLITCHTIP_DSN=

# Use controlled deployment labels, not automatic DEBUG-derived values.
GLITCHTIP_ENVIRONMENT=local
GLITCHTIP_RELEASE=local

# =============================================================================
# BACKEND — Database (PostgreSQL)
# All five vars must be set to enable PostgreSQL.
# If any is missing the backend falls back to SQLite (development only).
# =============================================================================

BACKEND_POSTGRES_DB=respira
BACKEND_POSTGRES_USER=respira_user
# Replace this placeholder before connecting to any non-local database.
BACKEND_POSTGRES_PASSWORD=change-me
BACKEND_POSTGRES_HOST=localhost
BACKEND_POSTGRES_PORT=5432

# Extra schemas appended to search_path, after the fixed
# `django_admin, respira_gold, public` prefix. Table ownership is not
# controlled by this variable — see docs/backend-env-vars.md. Leave unset
# unless you need an additional, unrelated schema on the path.
# BACKEND_POSTGRES_SCHEMA=

# =============================================================================
# BACKEND — Database SSL (optional)
# Uncomment and set the values your database provider requires.
# =============================================================================

# BACKEND_POSTGRES_SSLMODE=require
# BACKEND_POSTGRES_SSLROOTCERT=/app/certs/ca.pem
# BACKEND_POSTGRES_SSLCERT=/app/certs/client.crt
# BACKEND_POSTGRES_SSLKEY=/app/certs/client.key

# =============================================================================
# BACKEND — Process (optional)
# OS user/group gunicorn drops privileges to when the container starts as root.
# =============================================================================

# BACKEND_APP_USER=appuser
# BACKEND_APP_GROUP=appgroup

# =============================================================================
# BACKEND — Gunicorn (optional)
# Tune worker count and request limits to fit available server memory.
# Rule of thumb for workers: 2 × CPU cores + 1.
# =============================================================================

# BACKEND_GUNICORN_WORKERS=4
# BACKEND_GUNICORN_TIMEOUT=30
# BACKEND_GUNICORN_MAX_REQUESTS=1000
# BACKEND_GUNICORN_MAX_REQUESTS_JITTER=100

# =============================================================================
# BACKEND — Device Followers & Sensor Alerts (optional)
# The mobile follow endpoints are unauthenticated, so the throttle and the cap
# are what bound abuse of them. Push alerts stay off until switched on here.
#
# Switching them on is only half of it: `send_sensor_alerts` is a management
# command that nothing calls on its own, so it also needs the systemd timer in
# `utils/systemd/`. See docs/sensor-alerts.md.
# =============================================================================

# BACKEND_DEVICE_FOLLOWER_THROTTLE=120/min
# BACKEND_MAX_FOLLOWS_PER_INSTALLATION=10
# BACKEND_SENSOR_ALERTS_ENABLED=false

# =============================================================================
# BACKEND — Model Column Overrides (optional)
# Override only if your schema uses different column names than the defaults.
# =============================================================================

# BACKEND_STATION_READINGS_DATE_COLUMN=date_localtime
# BACKEND_INFERENCE_RESULTS_6H_COLUMN=forecast_6h
# BACKEND_INFERENCE_RESULTS_12H_COLUMN=forecast_12h

# =============================================================================
# BACKEND — Admin default superuser (staging/prod bootstrap)
# If both are set, entrypoint.sh creates this superuser on deploy (idempotent:
# an existing account is never modified). Use it to log into /admin/ on staging.
# Set a strong password; change it after first login. Leave unset to skip.
# =============================================================================

# This bootstrap account is for controlled setup only; do not ship the example
# identity or password unchanged.
BACKEND_SUPERUSER_EMAIL=admin@proyectorespira.net
BACKEND_SUPERUSER_PASSWORD=change-me-strong-password

# =============================================================================
# BACKEND — Admin auth & sessions (optional)
# Secure cookies default to ON whenever BACKEND_DEBUG=false, so most of these
# can stay unset in production. CSRF_TRUSTED_ORIGINS is REQUIRED when the admin
# is served over HTTPS behind the proxy.
# =============================================================================

# Comma-separated HTTPS origins trusted for admin POSTs behind the proxy.
# BACKEND_CSRF_TRUSTED_ORIGINS=https://proyectorespira.net,https://www.proyectorespira.net
# BACKEND_SESSION_COOKIE_AGE=28800
# BACKEND_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
# BACKEND_SESSION_SAVE_EVERY_REQUEST=false
# BACKEND_SESSION_COOKIE_SECURE=true
# BACKEND_CSRF_COOKIE_SECURE=true
# BACKEND_SESSION_COOKIE_SAMESITE=Lax
# BACKEND_CSRF_COOKIE_SAMESITE=Lax

# =============================================================================
# BACKEND — Security hardening (optional)
# Login rate limiting, password policy and HTTPS/HSTS. Production defaults
# follow BACKEND_DEBUG; override only to diverge.
# =============================================================================

# BACKEND_AXES_ENABLED=true
# BACKEND_AXES_FAILURE_LIMIT=5
# BACKEND_AXES_COOLOFF_HOURS=1
# BACKEND_PASSWORD_MIN_LENGTH=10
# BACKEND_PASSWORD_REQUIRE_SPECIAL=true
# BACKEND_SECURE_SSL_REDIRECT=true
# BACKEND_SECURE_HSTS_SECONDS=31536000
# BACKEND_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# BACKEND_SECURE_HSTS_PRELOAD=true
# BACKEND_SECURE_PROXY_SSL_HEADER=true
# BACKEND_X_FRAME_OPTIONS=DENY

# =============================================================================
# BACKEND — Email / password reset (optional)
# Enables Django's email password reset when SMTP is configured. In dev
# (BACKEND_DEBUG=true) emails print to the console.
# =============================================================================

# BACKEND_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# BACKEND_EMAIL_HOST=smtp.example.com
# BACKEND_EMAIL_PORT=587
# BACKEND_EMAIL_HOST_USER=apikey-or-username
# Never commit or deploy real SMTP credentials from an example file unchanged.
# BACKEND_EMAIL_HOST_PASSWORD=change-me
# BACKEND_EMAIL_USE_TLS=true
# BACKEND_DEFAULT_FROM_EMAIL=no-reply@proyectorespira.net

# Password recovery (admin + institutional panel).
# BACKEND_PASSWORD_RESET_TIMEOUT_HOURS: how long a reset link stays valid.
# BACKEND_INSTITUTION_PASSWORD_RESET_URL: the page the institutional reset email
#   points at. A path by default, so scheme and host follow the request and the
#   same value works in every environment; an absolute URL overrides that.
# The two throttles are per client IP and guard the endpoints that send the mail
#   and that consume the link.
# BACKEND_PASSWORD_RESET_TIMEOUT_HOURS=24
# BACKEND_INSTITUTION_PASSWORD_RESET_URL=/institucion/restablecer-clave
# BACKEND_PASSWORD_RESET_THROTTLE=10/hour
# BACKEND_PASSWORD_RESET_CONFIRM_THROTTLE=30/hour

# =============================================================================
# FRONTEND — Runtime Config (served via /runtime-config.json)
# =============================================================================

# Base URL of the backend API. No trailing slash.
# For browser: relative URL through proxy (e.g., /api) or absolute (e.g., http://localhost/api)
BACKEND_URL=http://localhost/api

# Backend URL for server-side rendering (Node.js). Must be absolute URL.
# Used only during SSR in the frontend container for data fetching.
# In docker-compose: should point to the backend service (e.g., http://backend:8000/api)
BACKEND_URL_INTERNAL=http://backend:8000/api

# Default region ID used for initial map requests.
PUBLIC_REGION_DEFAULT_ID=8495471280173798472

# Max distance (in km) from a region's bbox for geolocation to assign a user
# to it automatically. Users farther than this from every region fall back
# to PUBLIC_REGION_DEFAULT_ID. Optional, defaults to 100.
PUBLIC_REGION_MAX_DISTANCE_KM=100

# Port the Node.js SSR server listens on inside the frontend container.
FRONTEND_PORT=4321

# Public canonical URL of this site. No trailing slash. Used for share links.
SITE_URL=http://localhost

# Google Analytics measurement ID.
PUBLIC_GTAG=G-XXXXXXXXXX

# =============================================================================
# FRONTEND — Branding / White-label runtime config
# =============================================================================

# Contact inbox shown to users and used for outgoing contact mail.
CONTACT_MAIL=example@email.domain

# Public social and project link parts (domain/protocol are composed in code).
TWITTER_HANDLE=twitterhandle
TELEGRAM_CHANNEL=telegramchannel
FACEBOOK_PAGE=facebookpage
INSTAGRAM_HANDLE=instagramhandle
GITHUB_PATH=githubpath
SLACK_INVITE_PATH=slackinvitepath
APP_STORE_PATH=appstorepath
PLAY_STORE_APP_ID=playstoreappid

# =============================================================================
# FRONTEND — Email (server-side only, never exposed to the browser)
# =============================================================================

# Resend API key for contact-form emails.
# Replace with a real key per environment; never reuse the example value.
SMTP_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address shown in outgoing emails.
SMTP_SENDER=Respira <noreply@example.com>

# =============================================================================
# PROXY SERVICE
# =============================================================================

# Public hostname used in server_name and HTTP→HTTPS redirects.
SERVER_HOST=localhost

# Comma-separated IP/CIDR ranges allowed to access Django Admin (/admin/).
# Examples:
# PROXY_ADMIN_ALLOWED_IP_RANGES=203.0.113.10/32
# PROXY_ADMIN_ALLOWED_IP_RANGES=203.0.113.0/24,198.51.100.0/24
# If empty, /admin/ is blocked by default.
PROXY_ADMIN_ALLOWED_IP_RANGES=127.0.0.1/32

# Content Security Policy rollout. Use report-only first; set `off` for an
# emergency rollback. The Security Endpoint and origin are public frontend
# GlitchTip values and can remain blank to keep reports in browser consoles.
PROXY_CSP_MODE=report-only
PROXY_CSP_SECURITY_ENDPOINT=
PROXY_CSP_GLITCHTIP_ORIGIN=

# TLS certificate directory name under /etc/nginx/ssl/live/.
# Required for production and development targets. Omit for local.
# CERT_NAME=example.com
