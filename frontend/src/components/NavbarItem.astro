---
export const prerender = false;

import Typography from "./atoms/Typography.astro";
import { NavDropdown } from "./react/nav/NavDropdown";
import { getLangFromLocals } from "../i18n/utils";
const { title, route, type } = Astro.props;

// The dropdown hydrates, so its language has to be the one the server rendered
// with. Resolving it in the browser instead (from the cookie) makes a visitor
// on English or Portuguese hydrate over Spanish markup.
const lang = getLangFromLocals(Astro.locals);

let isModal = type === "modal";
let isDropdown = type === "dropdown";
---

<script>
  import { isAlertModalOpen } from "../store/modals";
  import { trackNavClick } from "../utils/analytics";

  const buttons = document.querySelectorAll("button.dialog");

  // Handle clicks on each button.
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      isAlertModalOpen.set(!isAlertModalOpen.get());
    });
  });

  // Track clicks on every main navigation option so we can measure which
  // menu items users use to move around the site.
  document.querySelectorAll<HTMLElement>("[data-track-nav]").forEach((el) => {
    if (el.dataset.navTrackBound === "1") return;
    el.dataset.navTrackBound = "1";

    el.addEventListener("click", () => {
      trackNavClick(el.dataset.trackNav ?? "", el.dataset.trackRoute ?? "");
    });
  });
</script>
{
  isModal && (
    <>
      <button
        class="dialog place-content-center cursor-default hidden md:block"
        data-dialog-target="dialog"
        data-track-nav={title}
        data-track-route={route}
      >
        <Typography variant="nav" customClass="m-auto select-none">
          {title}
        </Typography>
      </button>
      <a
        href={route}
        class={"md:hidden visible justify-items-start"}
        data-track-nav={title}
        data-track-route={route}
      >
        <li class="place-content-start cursor-default flex-row flex">
          <Typography variant="nav" customClass="m-auto select-none">
            {title}
          </Typography>
        </li>
      </a>
    </>
  )
}

{
  !isModal && isDropdown && (
    <NavDropdown
      client:load
      title={title}
      baseRoute={route.baseRoute}
      lang={lang}
    />
  )
}

{
  !isModal && !isDropdown && (
    <a
      href={route}
      class={isModal ? "md:hidden visible" : ""}
      data-track-nav={title}
      data-track-route={route}
    >
      <li class="place-content-center cursor-default">
        <Typography variant="nav" customClass="m-auto select-none">
          {title}
        </Typography>
      </li>
    </a>
  )
}
