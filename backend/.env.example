# =============================================================================
# BACKEND — Core Application
# Copy this file to backend/.env and fill in the values.
# =============================================================================

# Django secret key. Use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Replace this placeholder before any shared, staging, or production deploy.
BACKEND_SECRET_KEY=change-me-use-a-long-random-string

# Enable Django debug mode. Must be false in production.
BACKEND_DEBUG=false

# Port gunicorn binds to inside the container.
BACKEND_PORT=8000

# =============================================================================
# BACKEND — Database (PostgreSQL)
# All five vars must be set to enable PostgreSQL.
# If any is missing the backend falls back to SQLite (development only).
# =============================================================================

BACKEND_POSTGRES_DB=respira
BACKEND_POSTGRES_USER=respira_user
# Replace this placeholder before connecting to any non-local database.
BACKEND_POSTGRES_PASSWORD=change-me
BACKEND_POSTGRES_HOST=localhost
BACKEND_POSTGRES_PORT=5432

# Extra schemas appended to search_path, after the fixed
# `django_admin, respira_gold, public` prefix. Table ownership is not
# controlled by this variable — see docs/backend-env-vars.md. Leave unset
# unless you need an additional, unrelated schema on the path.
# BACKEND_POSTGRES_SCHEMA=

# =============================================================================
# BACKEND — Database SSL (optional)
# Uncomment and set the values your database provider requires.
# =============================================================================

# BACKEND_POSTGRES_SSLMODE=require
# BACKEND_POSTGRES_SSLROOTCERT=/app/certs/ca.pem
# BACKEND_POSTGRES_SSLCERT=/app/certs/client.crt
# BACKEND_POSTGRES_SSLKEY=/app/certs/client.key

# =============================================================================
# BACKEND — API
# =============================================================================

# Comma-separated list of origins allowed to make cross-site requests.
# In docker-compose: frontend service (http://frontend:4321) if it makes direct backend calls.
# Local dev: http://localhost:8000 and http://127.0.0.1:8000 for standalone backend.
BACKEND_CORS_ALLOWED_ORIGINS=http://frontend:4321,http://localhost:8000,http://127.0.0.1:8000

# Additional comma-separated hostnames appended to Django ALLOWED_HOSTS.
# Use bare hostnames only (no scheme, no port), for example: demo.proyectorespira.net,backend
# BACKEND_ALLOWED_HOSTS=demo.proyectorespira.net,backend

# =============================================================================
# GLITCHTIP — Error Monitoring (optional)
# =============================================================================

# Leave blank to disable backend error reporting.
BACKEND_GLITCHTIP_DSN=

# Use controlled deployment labels shared with the frontend when applicable.
GLITCHTIP_ENVIRONMENT=local
GLITCHTIP_RELEASE=local

# =============================================================================
# BACKEND — Admin default superuser (bootstrap)
# If both are set, entrypoint.sh creates this superuser on start (idempotent).
# =============================================================================

# BACKEND_SUPERUSER_EMAIL=admin@proyectorespira.net
# BACKEND_SUPERUSER_PASSWORD=change-me-strong-password

# =============================================================================
# BACKEND — Authentication & Sessions (Django Admin backoffice)
# See docs/admin-auth-configuration.md
# =============================================================================

# Session lifetime in seconds (default 28800 = 8 hours).
# BACKEND_SESSION_COOKIE_AGE=28800

# Expire the session when the browser closes (default false).
# BACKEND_SESSION_EXPIRE_AT_BROWSER_CLOSE=false

# Refresh the session expiry on every request (default false).
# BACKEND_SESSION_SAVE_EVERY_REQUEST=false

# Secure (HTTPS-only) cookies. Default: enabled whenever BACKEND_DEBUG=false.
# Set both to true in production; leave unset (or false) for local HTTP dev.
# BACKEND_SESSION_COOKIE_SECURE=true
# BACKEND_CSRF_COOKIE_SECURE=true

# SameSite policy for the session and CSRF cookies (Lax | Strict | None).
# BACKEND_SESSION_COOKIE_SAMESITE=Lax
# BACKEND_CSRF_COOKIE_SAMESITE=Lax

# Comma-separated origins trusted for CSRF-protected admin POSTs over HTTPS
# behind a proxy. Required for the admin to work over HTTPS in production.
# BACKEND_CSRF_TRUSTED_ORIGINS=https://proyectorespira.net,https://www.proyectorespira.net

# =============================================================================
# BACKEND — Email / password recovery (optional)
# Enables Django's built-in email password reset when SMTP is configured.
# Leave unset in dev: emails print to the console when BACKEND_DEBUG=true.
# =============================================================================

# BACKEND_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# BACKEND_EMAIL_HOST=smtp.example.com
# BACKEND_EMAIL_PORT=587
# BACKEND_EMAIL_HOST_USER=apikey-or-username
# Never commit or deploy real SMTP credentials from an example file unchanged.
# BACKEND_EMAIL_HOST_PASSWORD=change-me
# BACKEND_EMAIL_USE_TLS=true
# BACKEND_DEFAULT_FROM_EMAIL=no-reply@proyectorespira.net

# Password recovery (admin + institutional panel).
# BACKEND_PASSWORD_RESET_TIMEOUT_HOURS: how long a reset link stays valid.
# BACKEND_INSTITUTION_PASSWORD_RESET_URL: the page the institutional reset email
#   points at. A path by default, so scheme and host follow the request and the
#   same value works in every environment; an absolute URL overrides that.
# The two throttles are per client IP and guard the endpoints that send the mail
#   and that consume the link.
# BACKEND_PASSWORD_RESET_TIMEOUT_HOURS=24
# BACKEND_INSTITUTION_PASSWORD_RESET_URL=/institucion/restablecer-clave
# BACKEND_PASSWORD_RESET_THROTTLE=10/hour
# BACKEND_PASSWORD_RESET_CONFIRM_THROTTLE=30/hour

# =============================================================================
# BACKEND — Security hardening (Django Admin)
# See docs/admin-security-hardening.md. HTTPS-related settings default to ON
# whenever BACKEND_DEBUG=false; the values below override those defaults.
# =============================================================================

# Login rate limiting (django-axes).
# BACKEND_AXES_ENABLED=true
# BACKEND_AXES_FAILURE_LIMIT=5
# BACKEND_AXES_COOLOFF_HOURS=1

# Password policy.
# BACKEND_PASSWORD_MIN_LENGTH=10
# BACKEND_PASSWORD_REQUIRE_SPECIAL=true

# HTTPS / transport security (production). Defaults follow BACKEND_DEBUG.
# BACKEND_SECURE_SSL_REDIRECT=true
# BACKEND_SECURE_HSTS_SECONDS=31536000
# BACKEND_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# BACKEND_SECURE_HSTS_PRELOAD=true
# BACKEND_SECURE_PROXY_SSL_HEADER=true
# BACKEND_X_FRAME_OPTIONS=DENY

# =============================================================================
# BACKEND — Migrations & Process
# =============================================================================

# Run Django migrations automatically on container start.
BACKEND_RUN_MIGRATIONS=true

# OS user and group gunicorn drops privileges to.
# Only takes effect when the container starts as root.
# BACKEND_APP_USER=appuser
# BACKEND_APP_GROUP=appgroup

# =============================================================================
# BACKEND — Device Followers & Sensor Alerts (optional)
# The mobile follow endpoints are unauthenticated, so the throttle and the cap
# are what bound abuse of them. Push alerts stay off until switched on here.
# =============================================================================

# BACKEND_DEVICE_FOLLOWER_THROTTLE=120/min
# BACKEND_MAX_FOLLOWS_PER_INSTALLATION=10
# BACKEND_SENSOR_ALERTS_ENABLED=false

# =============================================================================
# BACKEND — Model Column Overrides (optional)
# Override DB column name mappings if your schema uses different names.
# =============================================================================

# BACKEND_STATION_READINGS_DATE_COLUMN=date_localtime
# BACKEND_INFERENCE_RESULTS_6H_COLUMN=forecast_6h
# BACKEND_INFERENCE_RESULTS_12H_COLUMN=forecast_12h
